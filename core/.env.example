# Resilience Platform Environment Variables Template
# Copy this file to .env and populate with your own keys/secrets.

# NextAuth Secret Key for Session Signing (Generate a random secret for production)
NEXTAUTH_SECRET="resilience-platform-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Database Connection (SQLite default for dev)
DATABASE_URL="file:./dev.db"
