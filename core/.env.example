# Resilience Platform Environment Variables Template
# Copy this file to .env and populate with your own keys/secrets.

# NextAuth Secret Key for Session Signing
NEXTAUTH_SECRET="resilience-platform-secret-change-in-production"
NEXTAUTH_URL="https://your-app.vercel.app"

# Supabase PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
