// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  testRuns     TestRun[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model TestRun {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  imageName        String
  status           String          @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  masterScore      Float?
  securityScore    Float?
  dastScore        Float?
  iacScore         Float?
  performanceScore Float?
  resilienceScore  Float?
  qualityGatePassed Boolean?
  qualityGateConfig String?
  loadConfig        String?
  securityLogs     SecurityLog[]
  sbomLogs         SbomLog[]
  secretLogs       SecretLog[]
  dastLogs         DastLog[]
  iacLogs          IacLog[]
  performanceMetrics PerformanceMetric[]
  chaosMetrics     ChaosMetric[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model SbomLog {
  id           String   @id @default(cuid())
  testRunId    String
  testRun      TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  totalPackages Int     @default(0)
  format       String   @default("CycloneDX")
  reportJson   String
  createdAt    DateTime @default(now())
}

model SecretLog {
  id           String   @id @default(cuid())
  testRunId    String
  testRun      TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  secretsCount Int      @default(0)
  licenseIssuesCount Int @default(0)
  reportJson   String
  createdAt    DateTime @default(now())
}

model SecurityLog {
  id           String   @id @default(cuid())
  testRunId    String
  testRun      TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  criticalCVEs Int      @default(0)
  highCVEs     Int      @default(0)
  mediumCVEs   Int      @default(0)
  reportJson   String // Store raw Trivy JSON output
  createdAt    DateTime @default(now())
}

model ChaosMetric {
  id           String   @id @default(cuid())
  testRunId    String
  testRun      TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  phase        String // e.g., "POD_KILL", "CPU_STRESS", "LOAD_TEST"
  rtoSeconds   Float? // Recovery Time Objective
  p95Latency   Float? // 95th Percentile Latency
  success      Boolean
  createdAt    DateTime @default(now())
}

model DastLog {
  id                String   @id @default(cuid())
  testRunId         String
  testRun           TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  sqlInjectionCount Int      @default(0)
  xssCount          Int      @default(0)
  brokenAuthCount   Int      @default(0)
  cveId             String?
  description       String?
  mitigationSteps   String?
  reportJson        String // Store raw OWASP ZAP JSON output
  createdAt         DateTime @default(now())
}

model IacLog {
  id                      String   @id @default(cuid())
  testRunId               String
  testRun                 TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  missingLimitsCount      Int      @default(0)
  rootPrivilegeCount      Int      @default(0)
  networkPolicyFlawsCount Int      @default(0)
  cveId                   String?
  description             String?
  mitigationSteps         String?
  reportJson              String // Store raw Checkov/KubeLinter JSON output
  createdAt               DateTime @default(now())
}

model PerformanceMetric {
  id           String   @id @default(cuid())
  testRunId    String
  testRun      TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  p95LatencyMs Float
  rps          Float
  successRate  Float
  createdAt    DateTime @default(now())
}
